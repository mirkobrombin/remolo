[Unit]
Description=remolo relay server (E2E-preserving fallback relay)
Documentation=https://github.com/mirkobrombin/remolo
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# Override the listen address with: systemctl edit remolo-relay
# and set Environment=REMOLO_RELAY_ADDR=:8788
Environment=REMOLO_RELAY_ADDR=:8788
ExecStart=/usr/bin/remolo-relay -addr ${REMOLO_RELAY_ADDR}
Restart=on-failure
RestartSec=3
DynamicUser=yes
NoNewPrivileges=yes

[Install]
WantedBy=multi-user.target
