[Unit]
Description=remolo rendezvous broker
Documentation=https://github.com/mirkobrombin/remolo
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
Environment=REMOLO_RENDEZVOUS_ADDR=:8787
Environment=REMOLO_RENDEZVOUS_TTL=10m
ExecStart=/usr/local/bin/remolo-rendezvous -addr ${REMOLO_RENDEZVOUS_ADDR} -ttl ${REMOLO_RENDEZVOUS_TTL}
Restart=on-failure
RestartSec=3
DynamicUser=yes
NoNewPrivileges=yes

[Install]
WantedBy=multi-user.target
