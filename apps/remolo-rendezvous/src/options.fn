package remolo.rendezvous_server

import std.net
import std.text
import std.time

struct options {
    address String
    port u64
    ttlNanoseconds u64
    help bool
}

fn argument(args [String], index usize) String {
    text.Copy(args[index])
}

fn valueAfter(
    args [String],
    index usize,
    name String
) Result<String, String> {
    if index + 1 < len(args) return .Ok(argument(args, index + 1))
    .Err(name + " requires a value")
}

fn assignedValue(
    source String,
    shortName String,
    longName String
) Option<String> {
    const shortPrefix = shortName + "="
    const longPrefix = longName + "="
    var start u64 = 0
    if text.StartsWith(source, shortPrefix) {
        start = text.ByteLen(shortPrefix)
    } else {
        if !text.StartsWith(source, longPrefix) return .None
        start = text.ByteLen(longPrefix)
    }
    const selected = text.Slice(source, start, text.ByteLen(source)) else {
        return .None
    }
    .Some(selected)
}

fn normalizedEndpoint(value String) String {
    if text.StartsWith(value, ":") return "0.0.0.0" + value
    text.Copy(value)
}

fn applyAddress(&value options, source String) Result<void, String> {
    const endpoint = net.ParseEndpoint(normalizedEndpoint(source)) else {
        return .Err("--addr requires host:port")
    }
    const net.Endpoint { Host Port } = endpoint
    value.address = Host
    value.port = u64.From(Port)
    .Ok
}

fn applyTTL(
    &value options,
    source String,
    name String
) Result<void, String> {
    const duration = time.Duration.Parse(source) else {
        return .Err(name + " requires a duration")
    }
    const nanoseconds = duration.Nanoseconds()
    if nanoseconds <= 0 {
        value.ttlNanoseconds = 600000000000
        return .Ok
    }
    const converted = u64.From(nanoseconds) else {
        return .Err(name + " is outside the supported range")
    }
    value.ttlNanoseconds = converted
    .Ok
}

fn parseOption(
    &value options,
    args [String],
    index usize
) Result<usize, String> {
    const name = argument(args, index)
    if name == "--help" || name == "-h" {
        value.help = true
        return .Ok(index + 1)
    }
    match assignedValue(name, "-addr", "--addr") {
        None: {}
        Some(source): {
            applyAddress(&value, source) else error { return .Err(error) }
            return .Ok(index + 1)
        }
    }
    match assignedValue(name, "-ttl", "--ttl") {
        None: {}
        Some(source): {
            applyTTL(&value, source, "-ttl") else error { return .Err(error) }
            return .Ok(index + 1)
        }
    }
    const source = valueAfter(args, index, name) else error {
        return .Err(error)
    }
    if name == "--addr" || name == "-addr" {
        applyAddress(&value, source) else error { return .Err(error) }
        return .Ok(index + 2)
    }
    if name == "--ttl" || name == "-ttl" {
        applyTTL(&value, source, name) else error { return .Err(error) }
        return .Ok(index + 2)
    }
    .Err("unknown option: " + name)
}

fn parseOptions(args [String]) Result<own options, String> {
    var value = own options {
        address = "0.0.0.0"
        port = 8787
        ttlNanoseconds = 600000000000
        help = false
    }
    var index usize = 0
    while index < len(args) {
        const next = parseOption(&value, args, index) else error {
            return .Err(error)
        }
        index = next
    }
    .Ok(value)
}

fn usage() String {
    "usage: remolo-rendezvous [-addr HOST:PORT] [-ttl DURATION]\n"
}
