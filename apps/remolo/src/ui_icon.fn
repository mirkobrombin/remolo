package remolo.cli

import foundation.ui
import std.bytes

extern c fn applicationIconNative() *const u8 as remolo_application_icon

fn setApplicationIcon(&window ui.Window) Result<void, ui.Error> {
    const pixels = applicationIcon() else error {
        discard error
        return .Err(.Failed)
    }
    window.SetApplicationIcon(64, 64, $pixels)
}

fn applicationIcon() Result<own bytes.Bytes, bytes.Error> {
    // SAFETY: the native symbol exposes 64 by 64 static RGBA pixels.
    unsafe {
        return bytes.CopyFromRaw(applicationIconNative(), 16384)
    }
}
