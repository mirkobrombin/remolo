package remolo.cli

enum cliCommand {
    Host
    Connect
    Webterm
    Desktop
    Info
    Token
    Forward
    REST
    FS
    Snapshot
    Exec
    Put
    Get
    Sync
    Help
}

struct commandName {
    value String
    command cliCommand
}

fn usage() String {
    "usage:\n" +
        "  remolo host [--bind HOST:PORT] [--advertise IP] [--loopback] " +
        "[--mdns] [--stun HOST:PORT] [--ttl SECONDS] [--identity PATH] " +
        "[--file-root PATH] " +
        "[--rendezvous URL] [--relay HOST:PORT] [--ro] [--once]\n" +
        "  remolo connect TOKEN [--mdns] [--rendezvous URL] " +
        "[--relay HOST:PORT] [-- COMMAND [ARG...]]\n" +
        "  remolo webterm TOKEN [--addr HOST:PORT] [--no-open]\n" +
        "  remolo desktop TOKEN [--addr HOST:PORT] [--fps RATE] [--no-open]\n" +
        "  remolo info TOKEN [--json]\n" +
        "  remolo token TOKEN\n" +
        "  remolo forward TOKEN [-L [BIND:]PORT:HOST:PORT] " +
        "[-D [BIND:]PORT]\n" +
        "  remolo rest TOKEN [--addr HOST:PORT]\n" +
        "  remolo fs TOKEN\n" +
        "  remolo snapshot TOKEN [--num COUNT] [--out PATH] [--diff]\n" +
        "  remolo exec TOKEN COMMAND [ARG...]\n" +
        "  remolo put TOKEN LOCAL REMOTE\n" +
        "  remolo get TOKEN REMOTE LOCAL\n" +
        "  remolo sync TOKEN LOCAL REMOTE [--pull] [--delete] [--dry-run]\n"
}

fn commandFor(value String) Option<cliCommand> {
    const names [17]commandName = [
        commandName { value = "host" command = .Host },
        commandName { value = "connect" command = .Connect },
        commandName { value = "webterm" command = .Webterm },
        commandName { value = "desktop" command = .Desktop },
        commandName { value = "info" command = .Info },
        commandName { value = "token" command = .Token },
        commandName { value = "forward" command = .Forward },
        commandName { value = "rest" command = .REST },
        commandName { value = "fs" command = .FS },
        commandName { value = "snapshot" command = .Snapshot },
        commandName { value = "exec" command = .Exec },
        commandName { value = "put" command = .Put },
        commandName { value = "get" command = .Get },
        commandName { value = "sync" command = .Sync },
        commandName { value = "help" command = .Help },
        commandName { value = "--help" command = .Help },
        commandName { value = "-h" command = .Help }
    ]
    for name in names {
        if value == name.value return .Some(name.command)
    }
    .None
}

fn executeCommand(command cliCommand, args [String]) Result<i32, failure> {
    match command {
        Host: runHost(args)
        Connect: runShell(args)
        Webterm: runWebterm(args)
        Desktop: runDesktop(args)
        Info: runInfo(args)
        Token: runToken(args)
        Forward: runForward(args)
        REST: runREST(args)
        FS: runFS(args)
        Snapshot: runSnapshot(args)
        Exec: runExec(args)
        Put: runPut(args)
        Get: runGet(args)
        Sync: runSync(args)
        Help: {
            writeStdoutText(usage()) else error { return .Err(error) }
            .Ok(0)
        }
    }
}

fn execute(args [String]) Result<i32, failure> {
    if len(args) == 0 return .Err(invalid("expected a command"))
    const name = argument(args, 0)
    const command = commandFor(name)
    match command {
        Some(value): executeCommand(value, args)
        None: .Err(invalid("unknown command: " + name))
    }
}

fn main(args [String]) i32 {
    const result = execute(args) else error {
        writeError("remolo: " + error.message + "\n")
        if error.code == 2 { writeError(usage()) }
        return error.code
    }
    result
}
