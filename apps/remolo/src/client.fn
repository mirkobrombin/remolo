package remolo.cli

import foundation.worker
import remolo.config
import remolo.dirsync
import remolo.identity
import remolo.protocol
import remolo.session
import remolo.token
import std.bytes
import std.collections
import std.format
import std.net
import std.text

struct fleetResult {
    index u64
    host String
    stdout own bytes.Bytes
    stderr own bytes.Bytes
    code i32
    message String
}

fn connectToken(value String) Result<own session.Client, failure> {
    const options = session.DefaultConnectOptions()
    connectTokenWith(value, $options)
}

fn connectViaJump(
    targetValue String,
    jumpValue String
) Result<own session.Client, failure> {
    const target = connectionCredential(targetValue) else error {
        return .Err(error)
    }
    const jump = connectionCredential(jumpValue) else error {
        discard target
        return .Err(error)
    }
    const connecting = spawn session.ConnectViaJump($target, $jump)
    const connectionResult = $connecting.wait()
    const connected = connectionResult else error {
        discard error
        return .Err(failed("could not connect through the jump host"))
    }
    .Ok(connected)
}

fn connectionCredential(value String) Result<own token.Token, failure> {
    const loaded = loadConfig() else error { return .Err(error) }
    var stored = loaded
    const selected = stored.TakeAlias(value)
    const encoded = match selected {
        Some(alias): {
            const tokenValue = aliasToken($alias) else error {
                return .Err(error)
            }
            tokenValue
        }
        None: text.Copy(value)
    }
    const credential = token.Decode(encoded) else error {
        discard error
        return .Err(invalid("invalid session token"))
    }
    .Ok(credential)
}

fn aliasToken($value own config.Alias) Result<String, failure> {
    const config.Alias {
        Name
        Token
        Rendezvous
        Relay
        Note
        HostKey
        Candidates
    } = value
    discard Name
    discard Rendezvous
    discard Relay
    discard Note
    discard Candidates
    if !text.IsEmpty(HostKey) {
        discard Token
        discard HostKey
        return .Err(invalid("jump hosts require a token-backed alias"))
    }
    discard HostKey
    .Ok(Token)
}

fn connectTokenWith(
    value String,
    $options own session.ConnectOptions
) Result<own session.Client, failure> {
    connectTokenUsing(value, $options, false)
}

fn connectTokenDedicatedWith(
    value String,
    $options own session.ConnectOptions
) Result<own session.Client, failure> {
    connectTokenUsing(value, $options, true)
}

fn connectTokenUsing(
    value String,
    $options own session.ConnectOptions,
    dedicated bool
) Result<own session.Client, failure> {
    const loaded = loadConfig() else error { return .Err(error) }
    var stored = loaded
    const selected = stored.TakeAlias(value)
    match selected {
        Some(alias): connectAlias($alias, $options, dedicated)
        None: connectRawToken(value, $options, dedicated)
    }
}

fn connectAlias(
    $value own config.Alias,
    $options own session.ConnectOptions,
    dedicated bool
) Result<own session.Client, failure> {
    const config.Alias {
        Name
        Token
        Rendezvous
        Relay
        Note
        HostKey
        Candidates
    } = value
    discard Name
    discard Note
    if !text.IsEmpty(HostKey) {
        discard Token
        discard Rendezvous
        discard Relay
        discard options
        return connectEnrolled($HostKey, $Candidates, dedicated)
    }
    discard HostKey
    discard Candidates
    var selected = options
    if text.IsEmpty(selected.Rendezvous) && !text.IsEmpty(Rendezvous) {
        selected.Rendezvous = Rendezvous
    } else {
        discard Rendezvous
    }
    if text.IsEmpty(selected.Relay) && !text.IsEmpty(Relay) {
        selected.Relay = Relay
    } else {
        discard Relay
    }
    connectRawToken(Token, $selected, dedicated)
}

fn connectRawToken(
    value String,
    $options own session.ConnectOptions,
    dedicated bool
) Result<own session.Client, failure> {
    const credential = token.Decode(value) else error {
        discard error
        discard options
        return .Err(invalid("invalid session token"))
    }
    if dedicated {
        const connecting = spawn session.ConnectWith($credential, $options)
        const connected = $connecting.wait()
        return match connected {
            Ok(client): .Ok(client)
            Err(error): {
                discard error
                .Err(failed("could not connect to the host"))
            }
        }
    }
    const connectionID = session.TokenConnectionID(credential) else error {
        discard error
        discard credential
        discard options
        return .Err(failed("could not identify the host session"))
    }
    const reusing = spawn session.DialDaemon($text.Copy(connectionID))
    const reused = $reusing.wait()
    match reused {
        Ok(found): match found {
            Some(client): {
                discard credential
                discard options
                discard connectionID
                return .Ok(client)
            }
            None: {}
        }
        Err(error): { discard error }
    }
    const connecting = spawn session.ConnectWith($credential, $options)
    const result = $connecting.wait()
    match result {
        Ok(client): {
            const starting = spawn session.StartDaemon($client, $connectionID)
            const started = $starting.wait()
            match started {
                Ok(local): .Ok(local)
                Err(error): {
                    discard error
                    .Err(failed("could not start the shared connection"))
                }
            }
        }
        Err(error): {
            discard error
            .Err(failed("could not connect to the host"))
        }
    }
}

fn connectEnrolled(
    $encodedHostKey String,
    $encodedCandidates own collections.List<String>,
    dedicated bool
) Result<own session.Client, failure> {
    const hostPublicKey = bytes.DecodeBase64(encodedHostKey) else error {
        discard error
        discard encodedCandidates
        return .Err(invalid("invalid enrolled host key"))
    }
    if dedicated {
        return connectEnrolledFresh($hostPublicKey, $encodedCandidates)
    }
    const connectionID = session.HostConnectionID(hostPublicKey) else error {
        discard error
        discard hostPublicKey
        discard encodedCandidates
        return .Err(failed("could not identify the enrolled host"))
    }
    const reusing = spawn session.DialDaemon($text.Copy(connectionID))
    const reused = $reusing.wait()
    match reused {
        Ok(found): match found {
            Some(client): {
                discard hostPublicKey
                discard encodedCandidates
                discard connectionID
                return .Ok(client)
            }
            None: {}
        }
        Err(error): { discard error }
    }
    const candidates = parseCandidates($encodedCandidates) else error {
        discard hostPublicKey
        discard connectionID
        return .Err(error)
    }
    const connected = connectEnrolledCandidates(
        $hostPublicKey,
        $candidates
    ) else error {
        discard connectionID
        return .Err(error)
    }
    const starting = spawn session.StartDaemon($connected, $connectionID)
    const started = $starting.wait()
    match started {
        Ok(local): .Ok(local)
        Err(error): {
            discard error
            .Err(failed("could not start the shared connection"))
        }
    }
}

fn connectEnrolledFresh(
    $hostPublicKey own bytes.Bytes,
    $encodedCandidates own collections.List<String>
) Result<own session.Client, failure> {
    const candidates = parseCandidates($encodedCandidates) else error {
        discard hostPublicKey
        return .Err(error)
    }
    connectEnrolledCandidates($hostPublicKey, $candidates)
}

fn connectEnrolledCandidates(
    $hostPublicKey own bytes.Bytes,
    $candidates own collections.List<token.Candidate>
) Result<own session.Client, failure> {
    const loading = spawn identity.LoadOrCreate($identity.DefaultClientKeyPath())
    const loaded = $loading.wait()
    const clientIdentity = loaded else error {
        discard error
        discard hostPublicKey
        discard candidates
        return .Err(failed("could not load the client identity"))
    }
    const connecting = spawn session.ConnectKey(
        $hostPublicKey,
        $candidates,
        $clientIdentity
    )
    const result = $connecting.wait()
    match result {
        Ok(client): {
            .Ok(client)
        }
        Err(error): {
            discard error
            .Err(failed("could not connect to the host"))
        }
    }
}

fn parseCandidates(
    $values own collections.List<String>
) Result<own collections.List<token.Candidate>, failure> {
    var pending = values
    var reversed = collections.NewList<token.Candidate>()
    while !pending.IsEmpty() {
        const source = stringValue(pending.PopFront())
        const endpoint = net.ParseEndpoint(source) else error {
            discard error
            discard pending
            discard reversed
            return .Err(invalid("invalid enrolled host endpoint: " + source))
        }
        const net.Endpoint { Host Port } = endpoint
        reversed.PushFront($token.Candidate { IP = Host Port = Port })
    }
    .Ok(reverseTokenCandidates($reversed))
}

fn tokenCandidateValue(
    $value Option<token.Candidate>
) token.Candidate {
    match value {
        Some(found): found
        None: { panic("enrolled candidate invariant failed") }
    }
}

fn reverseTokenCandidates(
    $values own collections.List<token.Candidate>
) own collections.List<token.Candidate> {
    var pending = values
    var result = collections.NewList<token.Candidate>()
    while !pending.IsEmpty() {
        result.PushFront($tokenCandidateValue(pending.PopFront()))
    }
    result
}

fn commandArguments(args [String], start usize) own collections.List<String> {
    var result = collections.NewList<String>()
    var index = len(args)
    while index > start {
        index -= 1
        result.PushFront(argument(args, index))
    }
    result
}

fn runExec(args [String]) Result<i32, failure> {
    if len(args) < 3 return .Err(invalid("exec requires a token and command"))
    const options = parseExecOptions(args) else error { return .Err(error) }
    if text.StartsWith(args[1], "@") return runFleetExec(args, $options)
    const descriptor = execDescriptor(args, $options)
    if terminalExec(descriptor.Kind) {
        return runExecTerminal(args[1], $descriptor)
    }
    const executed = executeDescriptor(args[1], $descriptor) else error {
        return .Err(error)
    }
    writeStdoutBytes(executed.Stdout) else error {
        return .Err(error)
    }
    writeStderrBytes(executed.Stderr) else error {
        return .Err(error)
    }
    const code = executed.Exit.Code
    .Ok(code)
}

fn execDescriptor(
    args [String],
    $options own execOptions
) protocol.Open {
    const execOptions {
        directory
        environment
        terminal
        quiet
        commandStart
    } = options
    discard quiet
    var descriptor = protocol.NewOpen(.PTY if terminal else .Exec)
    descriptor.Dir = directory
    descriptor.Env = environment
    const empty = replace descriptor.Command with commandArguments(args, commandStart)
    discard empty
    descriptor
}

fn executeDescriptor(
    tokenValue String,
    $descriptor protocol.Open
) Result<session.ExecResult, failure> {
    const client = connectToken(tokenValue) else error {
        discard descriptor
        return .Err(error)
    }
    const executing = spawn session.Execute(client.Handle(), $descriptor)
    const result = $executing.wait()
    session.CloseClient($client)
    const executed = result else error {
        discard error
        return .Err(failed("remote command failed"))
    }
    .Ok(executed)
}

fn runFleetExec(
    args [String],
    $options own execOptions
) Result<i32, failure> {
    const groupName = text.Slice(args[1], 1, text.ByteLen(args[1])) else error {
        discard error
        discard options
        return .Err(invalid("invalid group name"))
    }
    if text.IsEmpty(groupName) {
        discard options
        return .Err(invalid("exec requires a group name after @"))
    }
    const loaded = loadConfig() else error {
        discard options
        return .Err(error)
    }
    var stored = loaded
    const selected = stored.TakeGroup(groupName)
    discard stored
    const group = match selected {
        Some(value): value
        None: {
            discard options
            return .Err(failed("no group named \"" + groupName + "\""))
        }
    }
    const config.Group { Name Members } = group
    discard Name
    const count = fleetCount(Members.Len())
    if count == 0 {
        discard Members
        discard options
        return .Err(failed("group \"" + groupName + "\" is empty"))
    }
    discard options
    const Channel { sender receiver } = channel<fleetResult>(count)
    const workers = worker.NewSupervisor()
    var pending = Members
    var index u64 = 0
    while !pending.IsEmpty() {
        const member = fleetMember(pending.PopFront())
        const memberOptions = parseExecOptions(args) else error {
            const stopping = workers.CancelTask()
            discard $stopping.wait()
            discard sender
            discard receiver
            return .Err(error)
        }
        var descriptor = execDescriptor(args, $memberOptions)
        descriptor.Kind = .Exec
        workers.Start(spawn executeFleetMember(
                index,
                $member,
                $descriptor,
                sender.clone()
            ))
        index += 1
    }
    discard pending
    discard sender
    const collecting = spawn collectFleetResults($receiver, count)
    const results = $collecting.wait()
    const stopping = workers.ShutdownTask()
    discard $stopping.wait()
    printFleetResults($results)
}

task executeFleetMember(
    index u64,
    $host String,
    $descriptor protocol.Open,
    $results Sender<fleetResult>
) void {
    const result = executeDescriptor(host, $descriptor)
    const value = match result {
        Ok(executed): fleetSuccess(index, host, $executed)
        Err(error): fleetFailure(index, host, error.message)
    }
    const sent = results.send(value)
    match sent {
        Ok: {}
        Err(error): {
            discard error
            panic("fleet result channel closed")
        }
    }
}

task collectFleetResults(
    $receiver Receiver<fleetResult>,
    count u64
) own collections.List<fleetResult> {
    var inbox = receiver
    var values = collections.NewList<fleetResult>()
    var received u64 = 0
    while received < count {
        const receiving = inbox.receive()
        const next = receiving else error {
            discard error
            panic("fleet result channel closed")
        }
        values.PushFront($next)
        received += 1
    }
    discard inbox
    values
}

fn fleetSuccess(
    index u64,
    host String,
    $executed session.ExecResult
) fleetResult {
    const session.ExecResult { Exit Stdout Stderr } = executed
    const protocol.Exit { Code Error } = Exit
    fleetResult {
        index = index
        host = text.Copy(host)
        stdout = Stdout
        stderr = Stderr
        code = Code
        message = Error
    }
}

fn fleetFailure(index u64, host String, message String) fleetResult {
    fleetResult {
        index = index
        host = text.Copy(host)
        stdout = bytes.FromText("")
        stderr = bytes.FromText("")
        code = 1
        message = text.Copy(message)
    }
}

fn printFleetResults(
    $values own collections.List<fleetResult>
) Result<i32, failure> {
    var ordered = collections.Sort($values, compareFleetResults)
    var code i32 = 0
    while !ordered.IsEmpty() {
        const result = fleetResultValue(ordered.PopFront())
        const fleetResult { index host stdout stderr code as exitCode message } = result
        discard index
        writeStdoutText("=== " + host + " ===\n") else error {
            return .Err(error)
        }
        writeStdoutBytes(stdout) else error { return .Err(error) }
        writeStderrBytes(stderr) else error { return .Err(error) }
        if !text.IsEmpty(message) {
            writeError("  error: " + message + "\n")
        }
        if exitCode != 0 {
            writeError("  [exit " + format.I32(exitCode) + "]\n")
            code = exitCode
        }
    }
    .Ok(code)
}

fn compareFleetResults(left fleetResult, right fleetResult) i32 {
    if left.index < right.index return -1
    if left.index > right.index return 1
    0
}

fn terminalExec(value protocol.Kind) bool {
    match value {
        PTY: true
        _: false
    }
}

fn fleetCount(value i32) u64 {
    const result = u64.From(value) else error {
        discard error
        panic("group size invariant failed")
    }
    result
}

fn fleetMember($value Option<String>) String {
    match value {
        Some(member): member
        None: panic("group member invariant failed")
    }
}

fn fleetResultValue($value Option<fleetResult>) fleetResult {
    match value {
        Some(result): result
        None: panic("fleet result invariant failed")
    }
}

fn runPut(args [String]) Result<i32, failure> {
    if len(args) != 4 {
        return .Err(invalid("put requires TOKEN LOCAL REMOTE"))
    }
    const client = connectToken(args[1]) else error { return .Err(error) }
    const transferring = spawn session.PutFile(
        client.Handle(),
        argument(args, 2),
        argument(args, 3)
    )
    const result = $transferring.wait()
    session.CloseClient($client)
    result else error {
        discard error
        return .Err(failed("upload failed"))
    }
    .Ok(0)
}

fn runGet(args [String]) Result<i32, failure> {
    if len(args) != 4 {
        return .Err(invalid("get requires TOKEN REMOTE LOCAL"))
    }
    const client = connectToken(args[1]) else error { return .Err(error) }
    const transferring = spawn session.GetFile(
        client.Handle(),
        argument(args, 2),
        argument(args, 3)
    )
    const result = $transferring.wait()
    session.CloseClient($client)
    const received = result else error {
        discard error
        return .Err(failed("download failed"))
    }
    writeStdoutText(
        "downloaded " + format.U64(received) + " bytes\n"
    ) else error { return .Err(error) }
    .Ok(0)
}

fn runSync(args [String]) Result<i32, failure> {
    if len(args) < 4 {
        return .Err(invalid("sync requires TOKEN LOCAL REMOTE"))
    }
    const parsedOptions = parseSyncOptions(args, 4) else error {
        return .Err(error)
    }
    var parsed = parsedOptions
    const client = connectToken(args[1]) else error { return .Err(error) }
    const noExcludes [0]String = []
    var options = dirsync.NewOptions(noExcludes)
    while !parsed.excludes.IsEmpty() {
        const excluded = match parsed.excludes.PopFront() {
            None: panic("sync exclude invariant failed")
            Some(value): value
        }
        options.AddExclude(excluded)
    }
    options.Delete = parsed.delete
    options.DryRun = parsed.dryRun
    const syncing = if parsed.pull {
        spawn session.PullDirectory(
            client.Handle(),
            argument(args, 3),
            argument(args, 2),
            $options
        )
    } else {
        spawn session.PushDirectory(
            client.Handle(),
            argument(args, 2),
            argument(args, 3),
            $options
        )
    }
    const result = $syncing.wait()
    session.CloseClient($client)
    const stats = result else error {
        discard error
        return .Err(failed("directory sync failed"))
    }
    writeStdoutText(
        "transferred " + format.U64(stats.FilesTransferred) + "/" +
        format.U64(stats.FilesConsidered) + " files, " +
        format.U64(stats.BytesTransferred) + " bytes\n"
    ) else error { return .Err(error) }
    .Ok(0)
}
