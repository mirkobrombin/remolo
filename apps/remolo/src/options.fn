package remolo.cli

import remolo.session
import std.env
import std.net
import std.parse
import std.text

struct hostOptions {
    bindAddress String
    advertiseAddress String
    port u64
    ttl u64
    identityPath String
    fileRoot String
    rendezvous String
    includeLoopback bool
    mdns bool
    stun String
    relay String
    readOnly bool
    once bool
}

struct syncOptions {
    pull bool
    delete bool
    dryRun bool
}

enum hostSwitch {
    ReadOnly
    Once
    Loopback
    MDNS
}

enum hostValue {
    Bind
    Advertise
    TTL
    Identity
    FileRoot
    Rendezvous
    STUN
    Relay
}

fn argument(args [String], index usize) String {
    text.Copy(args[index])
}

fn optionValue(
    args [String],
    index usize,
    name String
) Result<String, failure> {
    if index + 1 < len(args) return .Ok(argument(args, index + 1))
    .Err(invalid(name + " requires a value"))
}

fn hostSwitchFor(name String) Option<hostSwitch> {
    if name == "--read-only" || name == "--ro" return .Some(.ReadOnly)
    if name == "--once" return .Some(.Once)
    if name == "--loopback" return .Some(.Loopback)
    if name == "--mdns" return .Some(.MDNS)
    .None
}

fn hostValueFor(name String) Option<hostValue> {
    if name == "--bind" return .Some(.Bind)
    if name == "--advertise" return .Some(.Advertise)
    if name == "--ttl" return .Some(.TTL)
    if name == "--identity" return .Some(.Identity)
    if name == "--file-root" return .Some(.FileRoot)
    if name == "--rendezvous" return .Some(.Rendezvous)
    if name == "--stun" return .Some(.STUN)
    if name == "--relay" return .Some(.Relay)
    .None
}

fn applyHostSwitch(&options hostOptions, value hostSwitch) void {
    match value {
        ReadOnly: { options.readOnly = true }
        Once: { options.once = true }
        Loopback: { options.includeLoopback = true }
        MDNS: { options.mdns = true }
    }
}

fn applyHostValue(
    &options hostOptions,
    selected hostValue,
    value String
) Result<void, failure> {
    match selected {
        Bind: applyBindValue(&options, value)
        Advertise: {
            options.advertiseAddress = text.Copy(value)
            .Ok
        }
        TTL: applyTTLValue(&options, value)
        Identity: {
            options.identityPath = text.Copy(value)
            .Ok
        }
        FileRoot: {
            options.fileRoot = text.Copy(value)
            .Ok
        }
        Rendezvous: {
            options.rendezvous = text.Copy(value)
            .Ok
        }
        STUN: {
            options.stun = text.Copy(value)
            .Ok
        }
        Relay: {
            options.relay = text.Copy(value)
            .Ok
        }
    }
}

fn applyBindValue(&options hostOptions, value String) Result<void, failure> {
    const endpoint = net.ParseEndpoint(value) else error {
        discard error
        return .Err(invalid("--bind requires host:port"))
    }
    const net.Endpoint { Host Port } = endpoint
    options.bindAddress = Host
    options.port = u64.From(Port)
    .Ok
}

fn applyTTLValue(&options hostOptions, value String) Result<void, failure> {
    const ttl = parse.U64(value) else error {
        discard error
        return .Err(invalid("--ttl requires seconds"))
    }
    if ttl == 0 return .Err(invalid("--ttl must be positive"))
    options.ttl = ttl
    .Ok
}

fn parseHostOption(
    &options hostOptions,
    args [String],
    index usize
) Result<usize, failure> {
    const name = argument(args, index)
    const switched = hostSwitchFor(name)
    match switched {
        Some(value): {
            applyHostSwitch(&options, value)
            return .Ok(index + 1)
        }
        None: {}
    }
    const valued = hostValueFor(name)
    const selected = match valued {
        Some(value): value
        None: { return .Err(invalid("unknown host option: " + name)) }
    }
    const value = optionValue(args, index, name) else error {
        return .Err(error)
    }
    applyHostValue(&options, selected, value) else error {
        return .Err(error)
    }
    .Ok(index + 2)
}

fn defaultFileRoot() String {
    const home = env.Home() else error {
        discard error
        return "."
    }
    match home {
        None: "."
        Some(path): path
    }
}

fn defaultHostOptions() own hostOptions {
    own hostOptions {
        bindAddress = "0.0.0.0"
        advertiseAddress = ""
        port = 0
        ttl = 86400
        identityPath = ""
        fileRoot = defaultFileRoot()
        rendezvous = ""
        includeLoopback = false
        mdns = false
        stun = ""
        relay = ""
        readOnly = false
        once = false
    }
}

struct connectOptions {
    connection own session.ConnectOptions
    commandStart usize
}

fn parseConnectOptions(
    args [String]
) Result<own connectOptions, failure> {
    var connection = session.DefaultConnectOptions()
    var index usize = 2
    var commandStart = len(args)
    var parsing = true
    while index < len(args) && parsing {
        const name = argument(args, index)
        if name == "--" {
            commandStart = index + 1
            parsing = false
            continue
        }
        if name == "--mdns" {
            connection.LocalDiscovery = true
            index += 1
            continue
        }
        if name == "--rendezvous" || name == "--relay" {
            const value = optionValue(args, index, name) else error {
                return .Err(error)
            }
            if name == "--rendezvous" {
                connection.Rendezvous = value
            } else {
                connection.Relay = value
            }
            index += 2
            continue
        }
        commandStart = index
        parsing = false
    }
    .Ok(own connectOptions {
        connection = connection
        commandStart = commandStart
    })
}

fn parseHostOptions(args [String]) Result<own hostOptions, failure> {
    var options = defaultHostOptions()
    var index usize = 1
    while index < len(args) {
        const next = parseHostOption(&options, args, index) else error {
            return .Err(error)
        }
        index = next
    }
    .Ok(options)
}

fn parseSyncOptions(args [String], start usize) Result<syncOptions, failure> {
    var options = syncOptions { pull = false delete = false dryRun = false }
    var index = start
    while index < len(args) {
        const name = argument(args, index)
        if name == "--pull" {
            options.pull = true
            index += 1
            continue
        }
        if name == "--delete" {
            options.delete = true
            index += 1
            continue
        }
        if name == "--dry-run" {
            options.dryRun = true
            index += 1
            continue
        }
        return .Err(invalid("unknown sync option: " + name))
    }
    .Ok(options)
}
