package remolo.cli

import remolo.protocol
import remolo.session
import std.collections
import std.env
import std.net
import std.text
import std.time

struct hostOptions {
    bindAddress String
    advertiseAddress String
    port u64
    ttl u64
    identityPath String
    fileRoot String
    rendezvous String
    includeLoopback bool
    mdns bool
    stun String
    relay String
    capabilities String
    commands String
    readOnly bool
    once bool
    approve bool
}

struct syncOptions {
    pull bool
    delete bool
    dryRun bool
    excludes own collections.List<String>
}

enum hostSwitch {
    ReadOnly
    Once
    Loopback
    MDNS
    Approve
}

enum hostValue {
    Bind
    Advertise
    TTL
    Identity
    FileRoot
    Rendezvous
    STUN
    Relay
    Capability
    Command
}

enum connectValue {
    Rendezvous
    Relay
    Jump
    SSHAddress
    SSHUser
    SSHKey
    SSHKnownHosts
    SSHTarget
}

fn argument(args [String], index usize) String {
    text.Copy(args[index])
}

fn optionValue(
    args [String],
    index usize,
    name String
) Result<String, failure> {
    if index + 1 < len(args) return .Ok(argument(args, index + 1))
    .Err(invalid(name + " requires a value"))
}

fn hostSwitchFor(name String) Option<hostSwitch> {
    if name == "--read-only" || name == "--ro" return .Some(.ReadOnly)
    if name == "--once" return .Some(.Once)
    if name == "--loopback" return .Some(.Loopback)
    if name == "--mdns" return .Some(.MDNS)
    if name == "--approve" return .Some(.Approve)
    .None
}

fn hostValueFor(name String) Option<hostValue> {
    if name == "--bind" || name == "-b" return .Some(.Bind)
    if name == "--advertise" return .Some(.Advertise)
    if name == "--ttl" return .Some(.TTL)
    if name == "--identity" return .Some(.Identity)
    if name == "--file-root" return .Some(.FileRoot)
    if name == "--rendezvous" return .Some(.Rendezvous)
    if name == "--stun" return .Some(.STUN)
    if name == "--relay" return .Some(.Relay)
    if name == "--cap" return .Some(.Capability)
    if name == "--cmd" return .Some(.Command)
    .None
}

fn connectValueFor(name String) Option<connectValue> {
    if name == "--rendezvous" return .Some(.Rendezvous)
    if name == "--relay" return .Some(.Relay)
    if name == "--jump" || name == "-J" return .Some(.Jump)
    if name == "--ssh-addr" return .Some(.SSHAddress)
    if name == "--ssh-user" return .Some(.SSHUser)
    if name == "--ssh-key" return .Some(.SSHKey)
    if name == "--ssh-known-hosts" return .Some(.SSHKnownHosts)
    if name == "--ssh-target" return .Some(.SSHTarget)
    .None
}

fn applyHostSwitch(&options hostOptions, value hostSwitch) void {
    match value {
        ReadOnly: { options.readOnly = true }
        Once: { options.once = true }
        Loopback: { options.includeLoopback = true }
        MDNS: { options.mdns = true }
        Approve: { options.approve = true }
    }
}

fn applyHostValue(
    &options hostOptions,
    selected hostValue,
    value String
) Result<void, failure> {
    match selected {
        Bind: applyBindValue(&options, value)
        Advertise: {
            options.advertiseAddress = text.Copy(value)
            .Ok
        }
        TTL: applyTTLValue(&options, value)
        Identity: {
            options.identityPath = text.Copy(value)
            .Ok
        }
        FileRoot: {
            options.fileRoot = text.Copy(value)
            .Ok
        }
        Rendezvous: {
            options.rendezvous = text.Copy(value)
            .Ok
        }
        STUN: {
            options.stun = text.Copy(value)
            .Ok
        }
        Relay: {
            options.relay = text.Copy(value)
            .Ok
        }
        Capability: {
            if !validCapability(value) {
                return .Err(invalid("unknown capability: " + value))
            }
            appendPolicyValue(&options.capabilities, value)
        }
        Command: appendPolicyValue(&options.commands, value)
    }
}

fn applyBindValue(&options hostOptions, value String) Result<void, failure> {
    const endpoint = net.ParseEndpoint(value) else error {
        discard error
        return .Err(invalid("--bind requires host:port"))
    }
    const net.Endpoint { Host Port } = endpoint
    options.bindAddress = Host
    options.port = u64.From(Port)
    .Ok
}

fn applyTTLValue(&options hostOptions, value String) Result<void, failure> {
    const duration = time.Duration.Parse(value) else error {
        discard error
        return .Err(invalid("--ttl requires a duration"))
    }
    const seconds = duration.Seconds()
    if seconds <= 0 {
        options.ttl = 86400
        return .Ok
    }
    const ttl = u64.From(seconds) else error {
        discard error
        return .Err(invalid("--ttl is outside the supported range"))
    }
    options.ttl = ttl
    .Ok
}

fn parseHostOption(
    &options hostOptions,
    args [String],
    index usize
) Result<usize, failure> {
    const name = argument(args, index)
    const switched = hostSwitchFor(name)
    match switched {
        Some(value): {
            applyHostSwitch(&options, value)
            return .Ok(index + 1)
        }
        None: {}
    }
    const valued = hostValueFor(name)
    const selected = match valued {
        Some(value): value
        None: { return .Err(invalid("unknown host option: " + name)) }
    }
    const value = optionValue(args, index, name) else error {
        return .Err(error)
    }
    applyHostValue(&options, selected, value) else error {
        return .Err(error)
    }
    .Ok(index + 2)
}

fn defaultFileRoot() String {
    const home = env.Home() else error {
        discard error
        return "."
    }
    match home {
        None: "."
        Some(path): path
    }
}

fn defaultHostOptions() own hostOptions {
    own hostOptions {
        bindAddress = "0.0.0.0"
        advertiseAddress = ""
        port = 0
        ttl = 86400
        identityPath = ""
        fileRoot = defaultFileRoot()
        rendezvous = ""
        includeLoopback = false
        mdns = false
        stun = ""
        relay = ""
        capabilities = ""
        commands = ""
        readOnly = false
        once = false
        approve = false
    }
}

fn appendPolicyValue(&encoded String, value String) Result<void, failure> {
    if text.IsEmpty(value) || text.Contains(value, "|") {
        return .Err(invalid("policy values cannot be empty or contain |"))
    }
    encoded = text.Copy(encoded) + "|" + value + "|"
    .Ok
}

fn validCapability(value String) bool {
    value == "pty" || value == "exec" || value == "file" ||
        value == "sync" || value == "rpc" || value == "desktop" ||
        value == "forward"
}

struct connectOptions {
    connection own session.ConnectOptions
    commandStart usize
    resume bool
    record String
    jump String
    forwardAgent bool
    sshAddress String
    sshUser String
    sshKey String
    sshKnownHosts String
    sshTarget String
}

struct execOptions {
    directory String
    environment own collections.List<protocol.Environment>
    terminal bool
    quiet bool
    commandStart usize
}

fn parseConnectOptions(
    args [String]
) Result<own connectOptions, failure> {
    var connection = session.DefaultConnectOptions()
    var index usize = 2
    var commandStart = len(args)
    var resume = false
    var record = ""
    var jump = ""
    var forwardAgent = false
    var sshAddress = ""
    var sshUser = ""
    var sshKey = ""
    var sshKnownHosts = ""
    var sshTarget = ""
    var parsing = true
    while index < len(args) && parsing {
        const name = argument(args, index)
        if name == "--" {
            commandStart = index + 1
            parsing = false
            continue
        }
        if name == "--mdns" {
            connection.LocalDiscovery = true
            index += 1
            continue
        }
        if name == "--resume" {
            resume = true
            index += 1
            continue
        }
        if name == "-A" || name == "--forward-agent" {
            forwardAgent = true
            index += 1
            continue
        }
        if name == "--record" {
            const value = optionValue(args, index, name) else error {
                return .Err(error)
            }
            record = value
            index += 2
            continue
        }
        const selected = connectValueFor(name)
        match selected {
            Some(kind): {
                const value = optionValue(args, index, name) else error {
                    return .Err(error)
                }
                match kind {
                    Rendezvous: { connection.Rendezvous = value }
                    Relay: { connection.Relay = value }
                    Jump: { jump = value }
                    SSHAddress: { sshAddress = value }
                    SSHUser: { sshUser = value }
                    SSHKey: { sshKey = value }
                    SSHKnownHosts: { sshKnownHosts = value }
                    SSHTarget: { sshTarget = value }
                }
                index += 2
                continue
            }
            None: {}
        }
        commandStart = index
        parsing = false
    }
    if !text.IsEmpty(sshAddress) {
        connection.SSH = .Some(own session.SSHRung {
            Address = text.Copy(sshAddress)
            User = text.Copy(sshUser)
            KeyPath = text.Copy(sshKey)
            KnownHosts = text.Copy(sshKnownHosts)
            Target = text.Copy(sshTarget)
        })
    }
    .Ok(own connectOptions {
        connection = connection
        commandStart = commandStart
        resume = resume
        record = record
        jump = jump
        forwardAgent = forwardAgent
        sshAddress = sshAddress
        sshUser = sshUser
        sshKey = sshKey
        sshKnownHosts = sshKnownHosts
        sshTarget = sshTarget
    })
}

fn parseExecOptions(args [String]) Result<own execOptions, failure> {
    var options = own execOptions {
        directory = ""
        environment = collections.NewList<protocol.Environment>()
        terminal = false
        quiet = false
        commandStart = len(args)
    }
    var index usize = 2
    var parsing = true
    while index < len(args) && parsing {
        const name = argument(args, index)
        if name == "--" {
            options.commandStart = index + 1
            parsing = false
            continue
        }
        if name == "-t" || name == "--tty" {
            options.terminal = true
            index += 1
            continue
        }
        if name == "-T" || name == "--no-tty" {
            options.terminal = false
            index += 1
            continue
        }
        if name == "-q" || name == "--quiet" {
            options.quiet = true
            index += 1
            continue
        }
        if name == "--cwd" || name == "--env" || name == "--env-pass" {
            const value = optionValue(args, index, name) else error {
                return .Err(error)
            }
            applyExecValue(&options, name, value) else error {
                return .Err(error)
            }
            index += 2
            continue
        }
        const inline = applyInlineExecValue(&options, name) else error {
            return .Err(error)
        }
        if inline {
            index += 1
        } else {
            options.commandStart = index
            parsing = false
        }
    }
    if options.commandStart >= len(args) {
        return .Err(invalid("exec requires a command"))
    }
    .Ok(options)
}

fn applyInlineExecValue(
    &options execOptions,
    name String
) Result<bool, failure> {
    if text.StartsWith(name, "--cwd=") {
        const value = inlineOptionValue(name, 6) else error {
            return .Err(error)
        }
        options.directory = value
        return .Ok(true)
    }
    if text.StartsWith(name, "--env=") {
        const value = inlineOptionValue(name, 6) else error {
            return .Err(error)
        }
        addExecEnvironment(&options, value) else error {
            return .Err(error)
        }
        return .Ok(true)
    }
    if text.StartsWith(name, "--env-pass=") {
        const value = inlineOptionValue(name, 11) else error {
            return .Err(error)
        }
        addPassedEnvironment(&options, value)
        return .Ok(true)
    }
    .Ok(false)
}

fn inlineOptionValue(value String, start u64) Result<String, failure> {
    const result = text.Slice(value, start, text.ByteLen(value)) else error {
        discard error
        return .Err(invalid("invalid inline option"))
    }
    if text.IsEmpty(result) return .Err(invalid("option value cannot be empty"))
    .Ok(result)
}

fn applyExecValue(
    &options execOptions,
    name String,
    value String
) Result<void, failure> {
    if name == "--cwd" {
        options.directory = text.Copy(value)
        return .Ok
    }
    if name == "--env" return addExecEnvironment(&options, value)
    addPassedEnvironment(&options, value)
    .Ok
}

fn addExecEnvironment(
    &options execOptions,
    value String
) Result<void, failure> {
    const separator = text.Find(value, "=")
    const offset = match separator {
        Some(found): found
        None: { return .Err(invalid("--env requires KEY=VALUE")) }
    }
    if offset == 0 return .Err(invalid("--env requires KEY=VALUE"))
    const name = text.Slice(value, 0, offset) else error {
        discard error
        return .Err(invalid("--env requires KEY=VALUE"))
    }
    const selected = text.Slice(value, offset + 1, text.ByteLen(value)) else error {
        discard error
        return .Err(invalid("--env requires KEY=VALUE"))
    }
    options.environment.PushFront(protocol.Environment {
        Name = name
        Value = selected
    })
    .Ok
}

fn addPassedEnvironment(&options execOptions, name String) void {
    const selected = env.Get(name) else error {
        discard error
        return
    }
    match selected {
        Some(value): options.environment.PushFront(protocol.Environment {
            Name = text.Copy(name)
            Value = value
        })
        None: {}
    }
}

fn parseHostOptions(args [String]) Result<own hostOptions, failure> {
    var options = defaultHostOptions()
    var index usize = 1
    while index < len(args) {
        const next = parseHostOption(&options, args, index) else error {
            return .Err(error)
        }
        index = next
    }
    .Ok(options)
}

fn parseSyncOptions(
    args [String],
    start usize
) Result<own syncOptions, failure> {
    var options = own syncOptions {
        pull = false
        delete = false
        dryRun = false
        excludes = collections.NewList<String>()
    }
    var index = start
    while index < len(args) {
        const name = argument(args, index)
        if name == "--pull" {
            options.pull = true
            index += 1
            continue
        }
        if name == "--delete" {
            options.delete = true
            index += 1
            continue
        }
        if name == "--dry-run" {
            options.dryRun = true
            index += 1
            continue
        }
        if name == "--exclude" {
            const value = optionValue(args, index, name) else error {
                return .Err(error)
            }
            options.excludes.PushFront($value)
            index += 2
            continue
        }
        if text.StartsWith(name, "--exclude=") {
            const value = inlineOptionValue(name, 10) else error {
                return .Err(error)
            }
            options.excludes.PushFront($value)
            index += 1
            continue
        }
        return .Err(invalid("unknown sync option: " + name))
    }
    .Ok(options)
}
