package remolo.rpc

import remolo.mux
import std.bytes
import std.collections
import std.json

task SystemInfo($handle mux.Handle) Result<SysInfo, Error> {
    const requesting = spawn Request($handle, $"sysinfo", $ .None)
    const response = $requesting.wait()
    const value = response else error { return .Err(error) }
    decodeSystemInfo($value)
}

task List($handle mux.Handle, $path String) Result<own collections.List<DirEntry>, Error> {
    const params = pathParams(path) else error { return .Err(error) }
    const requesting = spawn Request($handle, $"ls", $ .Some(params))
    const response = $requesting.wait()
    const value = response else error { return .Err(error) }
    decodeDirectory($value)
}

task Stat($handle mux.Handle, $path String) Result<StatResult, Error> {
    const params = pathParams(path) else error { return .Err(error) }
    const requesting = spawn Request($handle, $"stat", $ .Some(params))
    const response = $requesting.wait()
    const value = response else error { return .Err(error) }
    decodeStat($value)
}

task ReadAt(
    $handle mux.Handle,
    $path String,
    offset u64,
    length u64
) Result<own ReadResult, Error> {
    const params = rangeParams(path, offset, length) else error {
        return .Err(error)
    }
    const requesting = spawn Request($handle, $"pread", $ .Some(params))
    const response = $requesting.wait()
    const value = response else error { return .Err(error) }
    decodeRead($value)
}

task WriteAt(
    $handle mux.Handle,
    $path String,
    offset u64,
    $value own bytes.Bytes
) Result<u64, Error> {
    const params = writeParams(path, offset, value) else error {
        discard value
        return .Err(error)
    }
    discard value
    const requesting = spawn Request($handle, $"pwrite", $ .Some(params))
    const response = $requesting.wait()
    const selected = response else error { return .Err(error) }
    const fields = objectValue($selected) else error { return .Err(error) }
    var object = fields
    takeU64(&object, "n")
}

task Truncate(
    $handle mux.Handle,
    $path String,
    size u64
) Result<void, Error> {
    const params = sizeParams(path, size) else error { return .Err(error) }
    const calling = spawn callEmpty($handle, $"ftruncate", $params)
    const result = $calling.wait()
    result
}

task Create(
    $handle mux.Handle,
    $path String,
    mode u32
) Result<void, Error> {
    const params = modeParams(path, mode) else error { return .Err(error) }
    const calling = spawn callEmpty($handle, $"fcreate", $params)
    const result = $calling.wait()
    result
}

task MakeDirectory(
    $handle mux.Handle,
    $path String,
    mode u32
) Result<void, Error> {
    const params = modeParams(path, mode) else error { return .Err(error) }
    const calling = spawn callEmpty($handle, $"fmkdir", $params)
    const result = $calling.wait()
    result
}

task Remove($handle mux.Handle, $path String) Result<void, Error> {
    const params = pathParams(path) else error { return .Err(error) }
    const calling = spawn callEmpty($handle, $"fremove", $params)
    const result = $calling.wait()
    result
}

task Rename(
    $handle mux.Handle,
    $source String,
    $destination String
) Result<void, Error> {
    const params = renameParams(source, destination) else error {
        return .Err(error)
    }
    const calling = spawn callEmpty($handle, $"frename", $params)
    const result = $calling.wait()
    result
}

task callEmpty(
    $handle mux.Handle,
    $method String,
    $params json.Value
) Result<void, Error> {
    const requesting = spawn Request($handle, $method, $ .Some(params))
    const response = $requesting.wait()
    const value = response else error { return .Err(error) }
    discard value
    .Ok
}

task ExecuteList(
    $handle mux.Handle,
    $command own collections.List<String>
) Result<ExecResult, Error> {
    const params = commandListParams($command) else error { return .Err(error) }
    const requesting = spawn Request($handle, $"exec", $ .Some(params))
    const response = $requesting.wait()
    const value = response else error { return .Err(error) }
    decodeExecution($value)
}

task Enroll(
    $handle mux.Handle,
    $publicKey own bytes.Bytes,
    $label String
) Result<bool, Error> {
    const params = enrollmentParams(publicKey, label) else error {
        discard publicKey
        discard label
        return .Err(error)
    }
    discard publicKey
    discard label
    const requesting = spawn Request($handle, $"enroll", $ .Some(params))
    const response = $requesting.wait()
    const value = response else error { return .Err(error) }
    const selected = objectValue($value) else error { return .Err(error) }
    var object = selected
    takeBool(&object, "ok")
}

fn decodeSystemInfo($value json.Value) Result<SysInfo, Error> {
    const selected = objectValue($value) else error { return .Err(error) }
    var object = selected
    const os = takeText(&object, "os") else error { return .Err(error) }
    const arch = takeText(&object, "arch") else error { return .Err(error) }
    const hostname = takeText(&object, "hostname") else error {
        return .Err(error)
    }
    const cpus = takeU64(&object, "numcpu") else error { return .Err(error) }
    const uptime = takeU64(&object, "uptime") else error { return .Err(error) }
    .Ok(SysInfo {
        OS = os
        Arch = arch
        Hostname = hostname
        NumCPU = cpus
        Uptime = uptime
    })
}

fn decodeDirectory(
    $value json.Value
) Result<own collections.List<DirEntry>, Error> {
    var source = match value {
        Array(found): found
        _: { return .Err(.Protocol) }
    }
    var reversed = collections.NewList<DirEntry>()
    while source.Len() > 0 {
        const entryValue = match source.PopFront() {
            Some(found): found
            None: { panic("RPC directory array invariant failed") }
        }
        const entry = decodeDirectoryEntry($entryValue) else error {
            discard reversed
            return .Err(error)
        }
        reversed.PushFront($entry)
    }
    .Ok(reverseEntries($reversed))
}

fn decodeDirectoryEntry($value json.Value) Result<DirEntry, Error> {
    const selected = objectValue($value) else error { return .Err(error) }
    var object = selected
    const name = takeText(&object, "name") else error { return .Err(error) }
    const size = takeU64(&object, "size") else error { return .Err(error) }
    const isDir = takeBool(&object, "is_dir") else error { return .Err(error) }
    const mode = takeText(&object, "mode") else error { return .Err(error) }
    .Ok(DirEntry { Name = name Size = size IsDir = isDir Mode = mode })
}

fn decodeStat($value json.Value) Result<StatResult, Error> {
    const selected = objectValue($value) else error { return .Err(error) }
    var object = selected
    const name = takeText(&object, "name") else error { return .Err(error) }
    const size = takeU64(&object, "size") else error { return .Err(error) }
    const isDir = takeBool(&object, "is_dir") else error { return .Err(error) }
    const mode = takeText(&object, "mode") else error { return .Err(error) }
    const modified = takeU64(&object, "mod_time") else error {
        return .Err(error)
    }
    .Ok(StatResult {
        Name = name
        Size = size
        IsDir = isDir
        Mode = mode
        ModTime = modified
    })
}

fn decodeExecution($value json.Value) Result<ExecResult, Error> {
    const selected = objectValue($value) else error { return .Err(error) }
    var object = selected
    const stdout = takeText(&object, "stdout") else error { return .Err(error) }
    const stderr = takeText(&object, "stderr") else error { return .Err(error) }
    const code = takeI32(&object, "code") else error { return .Err(error) }
    .Ok(ExecResult { Stdout = stdout Stderr = stderr Code = code })
}

fn decodeRead($value json.Value) Result<own ReadResult, Error> {
    const selected = objectValue($value) else error { return .Err(error) }
    var object = selected
    const encoded = takeText(&object, "data") else error {
        return .Err(error)
    }
    const eof = takeBool(&object, "eof") else error { return .Err(error) }
    const data = bytes.DecodeBase64(encoded) else error {
        discard error
        return .Err(.Protocol)
    }
    .Ok(own ReadResult { Data = data EOF = eof })
}

fn objectValue($value json.Value) Result<own json.Object, Error> {
    match value {
        Object(found): .Ok(found)
        _: .Err(.Protocol)
    }
}
