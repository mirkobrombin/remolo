package remolo.session

import remolo.protocol
import remolo.relay
import remolo.token
import remolo.transport
import std.bytes
import std.text
import std.time

struct RelayHost {
    address String
    psk own bytes.Bytes
    publicKey own bytes.Bytes
    privateKey own bytes.Bytes
    sessionID own bytes.Bytes
    capabilities protocol.Capabilities
    expiry u64
    resume ResumeHandle
}

struct RelayHostAcceptOutcome {
    Host own RelayHost
    Value Result<own Peer, Error>
}

fn relayHostFor(
    $address String,
    psk bytes.Bytes,
    publicKey bytes.Bytes,
    privateKey bytes.Bytes,
    sessionID bytes.Bytes,
    capabilities protocol.Capabilities,
    expiry u64,
    resume ResumeHandle
) Result<Option<own RelayHost>, Error> {
    if text.IsEmpty(address) {
        discard address
        return .Ok(.None)
    }
    const relayPSK = psk.Copy() else error {
        discard error
        discard address
        return .Err(.Storage)
    }
    const relayPublicKey = publicKey.Copy() else error {
        discard error
        discard address
        discard relayPSK
        return .Err(.Storage)
    }
    const relayPrivateKey = privateKey.Copy() else error {
        discard error
        discard address
        discard relayPSK
        discard relayPublicKey
        return .Err(.Storage)
    }
    const relaySessionID = sessionID.Copy() else error {
        discard error
        discard address
        discard relayPSK
        discard relayPublicKey
        discard relayPrivateKey
        return .Err(.Storage)
    }
    .Ok(.Some(own RelayHost {
        address = address
        psk = relayPSK
        publicKey = relayPublicKey
        privateKey = relayPrivateKey
        sessionID = relaySessionID
        capabilities = protocol.CopyCapabilities(capabilities)
        expiry = expiry
        resume = resume.Clone()
    }))
}

task ConnectRelay(
    $credential own token.Token,
    $relayAddress String
) Result<own Client, Error> {
    if credential.Expired() return .Err(.Expired)
    const token.Token {
        Version
        HostPublicKey
        PSK
        Candidates
        SessionID
        Expiry
        Rendezvous
    } = credential
    discard Version
    discard Candidates
    discard Expiry
    discard Rendezvous
    const connecting = spawn connectRelayParts(
        $relayAddress,
        $HostPublicKey,
        $PSK,
        $SessionID
    )
    const result = $connecting.wait()
    result
}

task connectRelayParts(
    $relayAddress String,
    $hostPublicKey own bytes.Bytes,
    $psk own bytes.Bytes,
    $sessionID own bytes.Bytes
) Result<own Client, Error> {
    const session = bytesHex(sessionID) else error {
        discard error
        discard relayAddress
        return .Err(.Storage)
    }
    const transportKey = hostPublicKey.Copy() else error {
        discard error
        discard relayAddress
        discard session
        return .Err(.Storage)
    }
    const dialing = spawn relay.DialClient($relayAddress, $session)
    const connection = $dialing.wait()
    const connected = connection else error {
        discard error
        discard transportKey
        return .Err(.Transport)
    }
    const securing = spawn transport.SecureClientOver(
        $connected,
        $transportKey
    )
    const securedResult = $securing.wait()
    const secured = securedResult else error {
        discard error
        return .Err(.Transport)
    }
    const authPSK = psk.Copy() else error {
        discard error
        discard secured
        return .Err(.Storage)
    }
    const authKey = hostPublicKey.Copy() else error {
        discard error
        discard authPSK
        discard secured
        return .Err(.Storage)
    }
    const authenticating = spawn connectSecured(
        $secured,
        $authPSK,
        $authKey
    )
    const result = $authenticating.wait()
    result
}

task AcceptRelay(
    $host own Host,
    $relayAddress String
) HostAcceptOutcome {
    var restored = host
    if time.Now().Unix() > restored.expiry {
        discard relayAddress
        return HostAcceptOutcome {
            Host = restored
            Value = .Err(.Expired)
        }
    }
    const privateKey = restored.privateKey.Copy() else error {
        discard error
        discard relayAddress
        return HostAcceptOutcome {
            Host = restored
            Value = .Err(.Storage)
        }
    }
    const psk = restored.psk.Copy() else error {
        discard error
        discard privateKey
        discard relayAddress
        return HostAcceptOutcome {
            Host = restored
            Value = .Err(.Storage)
        }
    }
    const publicKey = restored.publicKey.Copy() else error {
        discard error
        discard privateKey
        discard psk
        discard relayAddress
        return HostAcceptOutcome {
            Host = restored
            Value = .Err(.Storage)
        }
    }
    const encodedCaps = protocol.EncodeCapabilities(
        restored.capabilities
    ) else error {
        discard error
        discard privateKey
        discard psk
        discard publicKey
        discard relayAddress
        return HostAcceptOutcome {
            Host = restored
            Value = .Err(.Protocol)
        }
    }
    const session = bytesHex(restored.sessionID) else error {
        discard error
        discard privateKey
        discard psk
        discard publicKey
        discard encodedCaps
        discard relayAddress
        return HostAcceptOutcome {
            Host = restored
            Value = .Err(.Storage)
        }
    }
    const registering = spawn relay.RegisterHost($relayAddress, $session)
    const connection = $registering.wait()
    const connected = connection else error {
        discard error
        discard privateKey
        discard psk
        discard publicKey
        discard encodedCaps
        return HostAcceptOutcome {
            Host = restored
            Value = .Err(.Transport)
        }
    }
    const authPrivateKey = privateKey.Copy() else error {
        discard error
        discard privateKey
        discard psk
        discard publicKey
        discard encodedCaps
        discard connected
        return HostAcceptOutcome {
            Host = restored
            Value = .Err(.Storage)
        }
    }
    const securing = spawn transport.SecureServerOver(
        $connected,
        $privateKey
    )
    const securedResult = $securing.wait()
    const secured = securedResult else error {
        discard error
        discard psk
        discard publicKey
        discard authPrivateKey
        discard encodedCaps
        return HostAcceptOutcome {
            Host = restored
            Value = .Err(.Transport)
        }
    }
    const authenticating = spawn acceptPeer(
        $secured,
        $psk,
        $publicKey,
        $authPrivateKey,
        "",
        restored.expiry,
        restored.resume.Handle(),
        $encodedCaps
    )
    const peer = $authenticating.wait()
    HostAcceptOutcome { Host = restored Value = peer }
}

task AcceptRelayHost(
    $host own RelayHost
) RelayHostAcceptOutcome {
    var restored = host
    if time.Now().Unix() > restored.expiry {
        return RelayHostAcceptOutcome {
            Host = restored
            Value = .Err(.Expired)
        }
    }
    const privateKey = restored.privateKey.Copy() else error {
        discard error
        return RelayHostAcceptOutcome {
            Host = restored
            Value = .Err(.Storage)
        }
    }
    const psk = restored.psk.Copy() else error {
        discard error
        discard privateKey
        return RelayHostAcceptOutcome {
            Host = restored
            Value = .Err(.Storage)
        }
    }
    const publicKey = restored.publicKey.Copy() else error {
        discard error
        discard privateKey
        discard psk
        return RelayHostAcceptOutcome {
            Host = restored
            Value = .Err(.Storage)
        }
    }
    const encodedCaps = protocol.EncodeCapabilities(
        restored.capabilities
    ) else error {
        discard error
        discard privateKey
        discard psk
        discard publicKey
        return RelayHostAcceptOutcome {
            Host = restored
            Value = .Err(.Protocol)
        }
    }
    const session = bytesHex(restored.sessionID) else error {
        discard error
        discard privateKey
        discard psk
        discard publicKey
        discard encodedCaps
        return RelayHostAcceptOutcome {
            Host = restored
            Value = .Err(.Storage)
        }
    }
    const registering = spawn relay.RegisterHost(
        $text.Copy(restored.address),
        $session
    )
    const registered = $registering.wait()
    const connected = registered else error {
        discard error
        discard privateKey
        discard psk
        discard publicKey
        discard encodedCaps
        return RelayHostAcceptOutcome {
            Host = restored
            Value = .Err(.Transport)
        }
    }
    const authPrivateKey = privateKey.Copy() else error {
        discard error
        discard privateKey
        discard psk
        discard publicKey
        discard encodedCaps
        discard connected
        return RelayHostAcceptOutcome {
            Host = restored
            Value = .Err(.Storage)
        }
    }
    const securing = spawn transport.SecureServerOver(
        $connected,
        $privateKey
    )
    const securedResult = $securing.wait()
    const secured = securedResult else error {
        discard error
        discard psk
        discard publicKey
        discard authPrivateKey
        discard encodedCaps
        return RelayHostAcceptOutcome {
            Host = restored
            Value = .Err(.Transport)
        }
    }
    const authenticating = spawn acceptPeer(
        $secured,
        $psk,
        $publicKey,
        $authPrivateKey,
        "",
        restored.expiry,
        cloneResumeHandle(restored.resume),
        $encodedCaps
    )
    const peer = $authenticating.wait()
    RelayHostAcceptOutcome { Host = restored Value = peer }
}

fn bytesHex(value bytes.Bytes) Result<String, Error> {
    const length = value.Len() else error {
        discard error
        return .Err(.Storage)
    }
    var builder = text.NewBuilder()
    var offset u64 = 0
    while offset < length {
        const byte = value.At(offset) else error {
            discard error
            discard builder
            return .Err(.Storage)
        }
        const high = builder.WriteCodePoint(hexCodePoint(byte >> 4)) else error {
            discard error
            discard builder
            return .Err(.Storage)
        }
        discard high
        const low = builder.WriteCodePoint(hexCodePoint(byte & 15)) else error {
            discard error
            discard builder
            return .Err(.Storage)
        }
        discard low
        offset += 1
    }
    const result = builder.Finish() else error {
        discard error
        return .Err(.Storage)
    }
    .Ok(result)
}

fn hexCodePoint(value u64) u64 {
    if value < 10 return 48 + value
    87 + value
}
