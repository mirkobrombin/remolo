package remolo.session

import foundation.worker
import remolo.desktop
import remolo.mux
import remolo.rpc
import remolo.tunnel
import std.text
import std.time

task ServePeer(
    $peer own Peer,
    $rootPath String,
    allowWrite bool
) Result<void, Error> {
    const startedAt = time.MonotonicNow()
    const serving = spawn servePeerSince($peer, $rootPath, allowWrite, startedAt)
    const result = $serving.wait()
    result
}

task servePeerSince(
    $peer own Peer,
    $rootPath String,
    allowWrite bool,
    startedAt time.MonotonicInstant
) Result<void, Error> {
    var active = peer
    const handle = active.Handle()
    const channels = worker.NewSupervisor()
    while true {
        const accepting = spawn mux.AcceptChannel($handle.Clone())
        const accepted = $accepting.wait()
        const channel = accepted else error {
            const result = acceptResult(error)
            discard handle
            discard rootPath
            ClosePeer($active)
            channels.Shutdown()
            return result
        }
        channels.Start(channelTask(
                $channel,
                $text.Copy(rootPath),
                allowWrite,
                startedAt
            ))
    }
    .Ok
}

task ServeHost(
    $host own Host,
    $rootPath String,
    allowWrite bool,
    once bool
) Result<void, Error> {
    var active = host
    const startedAt = time.MonotonicNow()
    const peers = worker.NewSupervisor()
    while true {
        const accepting = spawn Accept($active)
        const accepted = $accepting.wait()
        const HostAcceptOutcome { Host as restored Value } = accepted
        active = restored
        const peer = Value else error {
            discard active
            peers.Shutdown()
            return .Err(error)
        }
        if once {
            const serving = spawn servePeerSince(
                $peer,
                $rootPath,
                allowWrite,
                startedAt
            )
            const result = $serving.wait()
            discard active.Close()
            discard active
            peers.Shutdown()
            return result
        }
        peers.Start(spawn runPeer(
                $peer,
                $text.Copy(rootPath),
                allowWrite,
                startedAt
            ))
    }
    .Ok
}

task ServeRelayHost(
    $host own RelayHost,
    $rootPath String,
    allowWrite bool
) Result<void, Error> {
    var active = host
    const startedAt = time.MonotonicNow()
    while true {
        const accepting = spawn AcceptRelayHost($active)
        const accepted = $accepting.wait()
        const RelayHostAcceptOutcome { Host Value } = accepted
        active = Host
        const peer = Value else error {
            discard active
            discard rootPath
            return .Err(error)
        }
        const serving = spawn servePeerSince(
            $peer,
            $text.Copy(rootPath),
            allowWrite,
            startedAt
        )
        const result = $serving.wait()
        match result {
            Ok: {}
            Err(error): { discard error }
        }
    }
    .Ok
}

task runPeer(
    $peer own Peer,
    $rootPath String,
    allowWrite bool,
    startedAt time.MonotonicInstant
) void {
    const serving = spawn servePeerSince($peer, $rootPath, allowWrite, startedAt)
    const result = $serving.wait()
    match result {
        Ok: {}
        Err(error): { discard error }
    }
}

fn channelTask(
    $channel mux.AcceptedChannel,
    $rootPath String,
    allowWrite bool,
    startedAt time.MonotonicInstant
) Task<void> {
    const kind = channel.Open.Kind
    match kind {
        PTY: {
            discard rootPath
            if allowWrite return spawn runPTYChannel($channel)
            spawn rejectChannel($channel)
        }
        Exec: {
            discard rootPath
            if allowWrite return spawn runExecChannel($channel)
            spawn rejectChannel($channel)
        }
        Desktop: {
            discard rootPath
            spawn runDesktopChannel($channel)
        }
        File: {
            spawn runFileChannel(
                $channel,
                $rootPath,
                allowWrite
            )
        }
        Sync: {
            spawn runDirectoryChannel(
                $channel,
                $rootPath,
                allowWrite
            )
        }
        Forward: {
            discard rootPath
            spawn runForwardChannel($channel)
        }
        RPC: {
            spawn runRPCChannel(
                $channel,
                $rootPath,
                allowWrite,
                startedAt
            )
        }
        _: {
            discard rootPath
            spawn rejectChannel($channel)
        }
    }
}

task runDesktopChannel($channel mux.AcceptedChannel) void {
    const serving = spawn desktop.Serve($channel)
    const result = $serving.wait()
    discard result
}

task runPTYChannel($channel mux.AcceptedChannel) void {
    const serving = spawn servePTYChannel($channel)
    const result = $serving.wait()
    discard result
}

task runExecChannel($channel mux.AcceptedChannel) void {
    const serving = spawn serveExecChannel($channel)
    const result = $serving.wait()
    discard result
}

task runFileChannel(
    $channel mux.AcceptedChannel,
    $rootPath String,
    allowWrite bool
) void {
    const serving = spawn serveFileChannel(
        $channel,
        $rootPath,
        allowWrite
    )
    const result = $serving.wait()
    discard result
}

task runDirectoryChannel(
    $channel mux.AcceptedChannel,
    $rootPath String,
    allowWrite bool
) void {
    const serving = spawn serveDirectoryChannel(
        $channel,
        $rootPath,
        allowWrite
    )
    const result = $serving.wait()
    discard result
}

task runForwardChannel($channel mux.AcceptedChannel) void {
    const serving = spawn tunnel.ServeForwardChannel($channel)
    const result = $serving.wait()
    discard result
}

task runRPCChannel(
    $channel mux.AcceptedChannel,
    $rootPath String,
    allowExec bool,
    startedAt time.MonotonicInstant
) void {
    const serving = spawn rpc.Serve($channel, $rootPath, allowExec, startedAt)
    const result = $serving.wait()
    discard result
}

task rejectChannel($channel mux.AcceptedChannel) void {
    const control = channel.Stream.Control()
    discard channel
    const closing = spawn mux.CloseStream($control)
    const result = $closing.wait()
    discard result
}

fn acceptResult(error mux.Error) Result<void, Error> {
    match error {
        Closed: .Ok
        Transport: .Ok
        _: .Err(.Multiplex)
    }
}
