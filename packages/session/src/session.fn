package remolo.session

import remolo.discovery
import remolo.mux
import remolo.protocol
import remolo.token
import remolo.transport
import std.bytes
import std.collections

enum Error {
    Expired
    NoCandidate
    Transport
    Multiplex
    Protocol
    Authentication
    Execution
    FileTransfer
    DirectorySync
    Storage
}

struct Host {
    listener own transport.SecureListener
    psk own bytes.Bytes
    publicKey own bytes.Bytes
    privateKey own bytes.Bytes
    sessionID own bytes.Bytes
    capabilities protocol.Capabilities
    expiry u64
    advertisement Option<Task<Result<void, discovery.Error>>>
    relay Option<own RelayHost>

    fn Port(self) u64 {
        self.listener.Port()
    }

    fn Close(&self) bool {
        self.listener.Close()
    }

    fn TakeRelay(&self) Option<own RelayHost> {
        replace self.relay with .None
    }
}

struct ListeningHost {
    Host own Host
    Token own token.Token
}

struct HostOptions {
    BindAddress String
    AdvertiseAddress String
    Port u64
    IdentityPath String
    Capabilities protocol.Capabilities
    Expiry u64
    Rendezvous String
    IncludeLoopback bool
    MDNS bool
    STUN String
    Relay String
}

struct ConnectOptions {
    Rendezvous String
    Relay String
    LocalDiscovery bool
}

struct Client {
    session own mux.Session
    handle mux.Handle
    controlReader own mux.Reader
    controlWriter own mux.Writer
    sessionKey own bytes.Bytes
    capabilities protocol.Capabilities

    fn Capabilities(self) protocol.Capabilities {
        protocol.CopyCapabilities(self.capabilities)
    }

    fn Handle(self) mux.Handle {
        self.handle.Clone()
    }
}

struct Peer {
    session own mux.Session
    handle mux.Handle
    controlReader own mux.Reader
    controlWriter own mux.Writer
    sessionKey own bytes.Bytes

    fn Handle(self) mux.Handle {
        self.handle.Clone()
    }
}

struct HostAcceptOutcome {
    Host own Host
    Value Result<own Peer, Error>
}

struct clientControl {
    reader own mux.Reader
    writer own mux.Writer
    key own bytes.Bytes
    capabilities protocol.Capabilities
}

struct hostControl {
    reader own mux.Reader
    writer own mux.Writer
    key own bytes.Bytes
}

struct rawRead {
    reader own mux.Reader
    value own bytes.Bytes
}

struct candidateLists {
    TokenValues own collections.List<token.Candidate>
    RegistryValues own collections.List<token.Candidate>
}

struct connectionKeys {
    PublicKey own bytes.Bytes
    PSK own bytes.Bytes
}

fn copyConnectionKeys(
    publicKey bytes.Bytes,
    psk bytes.Bytes
) Result<own connectionKeys, Error> {
    const publicKeyCopy = publicKey.Copy() else error {
        discard error
        return .Err(.Storage)
    }
    const pskCopy = psk.Copy() else error {
        discard error
        discard publicKeyCopy
        return .Err(.Storage)
    }
    .Ok(own connectionKeys { PublicKey = publicKeyCopy PSK = pskCopy })
}

fn CloseClient($client own Client) void {
    const Client {
        session
        handle
        controlReader
        controlWriter
        sessionKey
        capabilities
    } = client
    discard handle
    discard controlReader
    discard controlWriter
    discard sessionKey
    discard capabilities
    mux.Close($session)
}

fn ClosePeer($peer own Peer) void {
    const Peer {
        session
        handle
        controlReader
        controlWriter
        sessionKey
    } = peer
    discard handle
    discard controlReader
    discard controlWriter
    discard sessionKey
    mux.Close($session)
}
