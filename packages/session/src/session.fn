package remolo.session

import remolo.discovery
import remolo.mux
import remolo.protocol
import remolo.token
import remolo.transport
import std.bytes
import std.collections
import std.concurrent
import std.text

enum Error {
    Expired
    NoCandidate
    Transport
    Multiplex
    Protocol
    Authentication
    Execution
    FileTransfer
    DirectorySync
    Storage
}

struct Host {
    port u64
    secureAcceptor Task<void>
    quicAcceptor Task<void>
    incoming Receiver<hostConnection>
    secureController own transport.SecureListenerController
    quicController own transport.QUICListenerController
    psk own bytes.Bytes
    publicKey own bytes.Bytes
    privateKey own bytes.Bytes
    sessionID own bytes.Bytes
    capabilities protocol.Capabilities
    expiry u64
    advertisement Option<Task<Result<void, discovery.Error>>>
    relay Option<own RelayHost>
    authorizedPath String
    resume own ResumeRegistry

    fn Port(self) u64 {
        self.port
    }

    fn Control(self) Result<own HostController, Error> {
        .Ok(own HostController {
            secure = self.secureController.Clone()
            quic = self.quicController.Clone()
        })
    }

    fn Close(&self) bool {
        const secureClosed = self.secureController.Close()
        const quicClosed = self.quicController.Close()
        secureClosed || quicClosed
    }

    fn TakeRelay(&self) Option<own RelayHost> {
        replace self.relay with .None
    }
}

@concurrent.Transferable()
struct HostController {
    secure own transport.SecureListenerController
    quic own transport.QUICListenerController

    fn Close(&self) bool {
        const secureClosed = self.secure.Close()
        const quicClosed = self.quic.Close()
        secureClosed || quicClosed
    }
}

struct ListeningHost {
    Host own Host
    Token own token.Token
}

struct HostOptions {
    BindAddress String
    AdvertiseAddress String
    Port u64
    IdentityPath String
    Capabilities protocol.Capabilities
    Expiry u64
    Rendezvous String
    IncludeLoopback bool
    MDNS bool
    STUN String
    Relay String
}

struct ConnectOptions {
    Rendezvous String
    Relay String
    LocalDiscovery bool
    Preferred Option<token.Candidate>
    SSH Option<own SSHRung>
}

struct SSHRung {
    Address String
    User String
    KeyPath String
    KnownHosts String
    Target String
}

struct Policy {
    AllowedKinds String
    AllowedCommands String
    AllowWrite bool
    Approve bool
}

fn NewPolicy(
    allowedKinds String,
    allowedCommands String,
    allowWrite bool,
    approve bool
) Policy {
    Policy {
        AllowedKinds = text.Copy(allowedKinds)
        AllowedCommands = text.Copy(allowedCommands)
        AllowWrite = allowWrite
        Approve = approve
    }
}

fn DefaultPolicy(allowWrite bool) Policy {
    NewPolicy("", "", allowWrite, false)
}

fn copyPolicy(value Policy) Policy {
    NewPolicy(
        value.AllowedKinds,
        value.AllowedCommands,
        value.AllowWrite,
        value.Approve
    )
}

struct Client {
    session own mux.Session
    handle mux.Handle
    controlReader own mux.Reader
    controlWriter own mux.Writer
    sessionKey own bytes.Bytes
    capabilities protocol.Capabilities
    daemon Option<own DaemonOwner>
    route Option<own RouteOwner>
    agent Option<own AgentForwardOwner>

    fn Capabilities(self) protocol.Capabilities {
        protocol.CopyCapabilities(self.capabilities)
    }

    fn Handle(self) mux.Handle {
        self.handle.Clone()
    }
}

struct Peer {
    session own mux.Session
    handle mux.Handle
    controlReader own mux.Reader
    controlWriter own mux.Writer
    sessionKey own bytes.Bytes
    authorizedPath String
    resume ResumeHandle

    fn Handle(self) mux.Handle {
        self.handle.Clone()
    }
}

struct HostAcceptOutcome {
    Host own Host
    Value Result<own Peer, Error>
}

struct clientControl {
    reader own mux.Reader
    writer own mux.Writer
    key own bytes.Bytes
    capabilities protocol.Capabilities
}

struct hostControl {
    reader own mux.Reader
    writer own mux.Writer
    key own bytes.Bytes
}

struct rawRead {
    reader own mux.Reader
    value own bytes.Bytes
}

struct candidateLists {
    TokenValues own collections.List<token.Candidate>
    RegistryValues own collections.List<token.Candidate>
}

struct connectionKeys {
    PublicKey own bytes.Bytes
    PSK own bytes.Bytes
}

fn copyConnectionKeys(
    publicKey bytes.Bytes,
    psk bytes.Bytes
) Result<own connectionKeys, Error> {
    const publicKeyCopy = publicKey.Copy() else error {
        discard error
        return .Err(.Storage)
    }
    const pskCopy = psk.Copy() else error {
        discard error
        discard publicKeyCopy
        return .Err(.Storage)
    }
    .Ok(own connectionKeys { PublicKey = publicKeyCopy PSK = pskCopy })
}

fn CloseClient($client own Client) void {
    const Client {
        session
        handle
        controlReader
        controlWriter
        sessionKey
        capabilities
        daemon
        route
        agent
    } = client
    mux.Close($session)
    discard agent
    discard route
    discard daemon
    discard handle
    discard controlReader
    discard controlWriter
    discard sessionKey
    discard capabilities
}

fn ClosePeer($peer own Peer) void {
    const Peer {
        session
        handle
        controlReader
        controlWriter
        sessionKey
        authorizedPath
        resume
    } = peer
    discard handle
    discard controlReader
    discard controlWriter
    discard sessionKey
    discard authorizedPath
    discard resume
    mux.Close($session)
}
