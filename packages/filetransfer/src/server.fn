package remolo.filetransfer

import remolo.mux
import remolo.protocol
import std.bytes
import std.fs
import std.path
import std.text

task Serve(
    $stream mux.Stream,
    $rootPath String,
    allowWrite bool
) Result<void, Error> {
    const mux.Stream { ID Reader Writer } = stream
    discard ID
    const reading = spawn mux.ReadFrame($Reader)
    const outcome = $reading.wait()
    const mux.FrameReadOutcome { Reader as restored Value } = outcome
    const frame = Value else error {
        discard error
        discard restored
        discard Writer
        discard rootPath
        return .Err(.Protocol)
    }
    const protocol.Frame { Type Payload } = frame
    if !isJSON(Type) {
        discard Payload
        discard restored
        discard Writer
        discard rootPath
        return .Err(.Protocol)
    }
    const request = decodeRequest(Payload) else error {
        discard error
        discard restored
        discard Writer
        discard rootPath
        return .Err(.InvalidRequest)
    }
    const root = fs.OpenRoot(rootPath) else error {
        discard error
        discard restored
        discard Writer
        return .Err(.Filesystem)
    }
    if request.Operation == "put" {
        if !allowWrite {
            const drained = spawn drainFile($restored)
            const reader = $drained.wait()
            discard reader
            const rejected = spawn sendExit($Writer, 1, "uploads not allowed")
            const rejection = $rejected.wait()
            const writer = rejection else error {
                discard root
                return .Err(error)
            }
            discard writer
            discard root
            return .Err(.ReadOnly)
        }
        const serving = spawn servePut($restored, $Writer, $root, $request)
        const result = $serving.wait()
        result
    } else {
        discard restored
        const serving = spawn serveGet($Writer, $root, $request)
        const result = $serving.wait()
        result
    }
}

task servePut(
    $reader own mux.Reader,
    $writer own mux.Writer,
    $root own fs.RootWriter,
    $request Request
) Result<void, Error> {
    const Request {
        Operation
        Path
        Offset
        Size
        SHA256
    } = request
    discard Operation
    discard Size
    var destinationRoot = root
    const parent = path.Parent(Path)
    if parent != "." {
        destinationRoot.CreateDirectory(parent) else error {
            discard error
            const rejecting = spawn drainAndReject(
                $reader,
                $writer,
                $"invalid destination"
            )
            $rejecting.wait()
            discard Path
            discard SHA256
            discard destinationRoot
            return .Err(.Filesystem)
        }
    }
    const mode = if Offset == 0 { fs.FileMode.Truncate } else {
        fs.FileMode.Write
    }
    const opening = spawn fs.OpenRootFile(
        $destinationRoot,
        $text.Copy(Path),
        mode
    )
    const opened = $opening.wait()
    const fs.RootFileOpenOutcome { Root Value } = opened
    destinationRoot = Root
    const file = Value else error {
        discard error
        const rejecting = spawn drainAndReject(
            $reader,
            $writer,
            $"invalid destination"
        )
        $rejecting.wait()
        discard Path
        discard SHA256
        discard destinationRoot
        return .Err(.Filesystem)
    }
    const seeking = spawn fs.SeekFile($file, Offset)
    const sought = $seeking.wait()
    const fs.FileOutcome { File Value as seekValue } = sought
    seekValue else error {
        discard error
        discard File
        const rejecting = spawn drainAndReject(
            $reader,
            $writer,
            $"invalid offset"
        )
        $rejecting.wait()
        discard Path
        discard SHA256
        discard destinationRoot
        return .Err(.Filesystem)
    }
    const receiving = spawn receiveFile($reader, $File)
    const received = $receiving.wait()
    const receiveOutcome {
        Reader
        File as writtenFile
        Value as receivedValue
    } = received
    const written = receivedValue else error {
        discard writtenFile
        const rejecting = spawn drainAndReject(
            $Reader,
            $writer,
            $"transfer failed"
        )
        $rejecting.wait()
        discard Path
        discard SHA256
        discard destinationRoot
        return .Err(error)
    }
    discard written
    discard Reader
    const syncing = spawn fs.SyncFile($writtenFile)
    const synced = $syncing.wait()
    const fs.FileOutcome { File as syncedFile Value as syncValue } = synced
    syncValue else error {
        discard error
        discard syncedFile
        const rejected = spawn reject($writer, $"sync failed")
        $rejected.wait()
        discard Path
        discard SHA256
        discard destinationRoot
        return .Err(.Filesystem)
    }
    var completedFile = syncedFile
    discard completedFile.Close()
    discard completedFile
    const hashing = spawn hashRootFile($destinationRoot, $text.Copy(Path))
    const hashed = $hashing.wait()
    const rootHashOutcome { Root as hashedRoot Value as hashValue } = hashed
    discard hashedRoot
    const checksum = hashValue else error {
        const rejected = spawn reject($writer, $"hash failed")
        $rejected.wait()
        discard Path
        discard SHA256
        return .Err(error)
    }
    if !text.IsEmpty(SHA256) && checksum != SHA256 {
        const rejected = spawn reject($writer, $"sha256 mismatch")
        $rejected.wait()
        discard Path
        discard SHA256
        return .Err(.Integrity)
    }
    discard Path
    discard SHA256
    const acknowledged = spawn sendExit($writer, 0, $checksum)
    const acknowledgment = $acknowledged.wait()
    const finalWriter = acknowledgment else error {
        return .Err(error)
    }
    const closing = spawn mux.CloseWriter($finalWriter)
    const closed = $closing.wait()
    closed else error {
        discard error
        return .Err(.Protocol)
    }
    .Ok
}

task serveGet(
    $writer own mux.Writer,
    $root own fs.RootWriter,
    $request Request
) Result<void, Error> {
    const Request {
        Operation
        Path
        Offset
        Size
        SHA256
    } = request
    discard Operation
    discard Size
    discard SHA256
    const hashing = spawn hashRootFile($root, $text.Copy(Path))
    const hashed = $hashing.wait()
    const rootHashOutcome { Root as sourceRoot Value as hashValue } = hashed
    const checksum = hashValue else error {
        discard sourceRoot
        const rejected = spawn reject($writer, $"source not found")
        $rejected.wait()
        discard Path
        return .Err(error)
    }
    const opening = spawn fs.OpenRootFile(
        $sourceRoot,
        $Path,
        .Read
    )
    const opened = $opening.wait()
    const fs.RootFileOpenOutcome { Root Value } = opened
    discard Root
    const source = Value else error {
        discard error
        const rejected = spawn reject($writer, $"source not found")
        $rejected.wait()
        return .Err(.Filesystem)
    }
    const sizing = spawn fs.SizeFile($source)
    const sized = $sizing.wait()
    const fs.FileSizeOutcome { File Value as sizeValue } = sized
    const size = sizeValue else error {
        discard error
        discard File
        const rejected = spawn reject($writer, $"source size failed")
        $rejected.wait()
        return .Err(.Filesystem)
    }
    if Offset > size {
        discard File
        const rejected = spawn reject($writer, $"offset beyond source")
        $rejected.wait()
        return .Err(.InvalidRequest)
    }
    const seeking = spawn fs.SeekFile($File, Offset)
    const sought = $seeking.wait()
    const fs.FileOutcome { File as sourceFile Value as seekValue } = sought
    seekValue else error {
        discard error
        discard sourceFile
        const rejected = spawn reject($writer, $"source seek failed")
        $rejected.wait()
        return .Err(.Filesystem)
    }
    const streaming = spawn sendFile($writer, $sourceFile)
    const streamResult = $streaming.wait()
    const dataWriter = streamResult else error { return .Err(error) }
    const eof = spawn writeFrame($dataWriter, .EOF, $bytes.FromText(""))
    const eofResult = $eof.wait()
    const eofWriter = eofResult else error { return .Err(error) }
    const acknowledged = spawn sendExit($eofWriter, 0, $checksum)
    const acknowledgment = $acknowledged.wait()
    const finalWriter = acknowledgment else error {
        return .Err(error)
    }
    const closing = spawn mux.CloseWriter($finalWriter)
    const closed = $closing.wait()
    closed else error {
        discard error
        return .Err(.Protocol)
    }
    .Ok
}
