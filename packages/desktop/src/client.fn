package remolo.desktop

import remolo.mux
import remolo.protocol
import std.concurrent

@concurrent.Transferable()
struct Reader {
    source own mux.Reader
}

@concurrent.Transferable()
struct Writer {
    destination own mux.Writer
}

@concurrent.Transferable()
struct Controller {
    control mux.StreamControl
}

@concurrent.Transferable()
struct RemoteDesktop {
    Reader own Reader
    Writer own Writer
    Controller own Controller
    Hello own Hello
}

enum Event {
    Frame(value own EncodedFrame)
    Exit
}

struct ReadOutcome {
    Reader own Reader
    Value Result<Event, Error>
}

task Open(
    $handle mux.Handle,
    fps u64
) Result<own RemoteDesktop, Error> {
    const descriptor = protocol.NewOpen(.Desktop)
    const opening = spawn mux.OpenChannel($handle, $descriptor)
    const openedResult = $opening.wait()
    const opened = openedResult else error {
        discard error
        return .Err(.Closed)
    }
    const control = opened.Control()
    const mux.Stream { ID Reader Writer } = opened
    discard ID
    const reading = spawn mux.ReadFrame($Reader)
    const outcome = $reading.wait()
    const mux.FrameReadOutcome { Reader as restored Value } = outcome
    const frame = Value else error {
        discard error
        discard restored
        discard Writer
        discard control
        return .Err(.Closed)
    }
    const protocol.Frame { Type Payload } = frame
    if !jsonFrame(Type) {
        discard Payload
        discard restored
        discard Writer
        discard control
        return .Err(.Protocol)
    }
    const hello = DecodeHello(Payload) else error {
        discard restored
        discard Writer
        discard control
        return .Err(error)
    }
    const selection = EncodeSelect(Select {
        Mode = .Screenshot
        FPS = normalizedFPS(fps)
    }) else error {
        discard hello
        discard restored
        discard Writer
        discard control
        return .Err(error)
    }
    const sending = spawn desktopSend($Writer, .JSON, $selection)
    const sent = $sending.wait()
    const destination = sent else error {
        discard hello
        discard restored
        discard control
        return .Err(error)
    }
    .Ok(own RemoteDesktop {
        Reader = own Reader { source = restored }
        Writer = own Writer { destination = destination }
        Controller = own Controller { control = control }
        Hello = hello
    })
}

task Read($reader own Reader) ReadOutcome {
    const Reader { source } = reader
    const reading = spawn mux.ReadFrame($source)
    const outcome = $reading.wait()
    const mux.FrameReadOutcome { Reader Value } = outcome
    const restored = own Reader { source = Reader }
    const frame = Value else error {
        discard error
        return ReadOutcome { Reader = restored Value = .Err(.Closed) }
    }
    const protocol.Frame { Type Payload } = frame
    match Type {
        Data: {
            const decoded = DecodeFullFrame(Payload) else error {
                return ReadOutcome { Reader = restored Value = .Err(error) }
            }
            ReadOutcome {
                Reader = restored
                Value = .Ok(.Frame(value = $decoded))
            }
        }
        Exit: {
            discard Payload
            ReadOutcome { Reader = restored Value = .Ok(.Exit) }
        }
        EOF: {
            discard Payload
            ReadOutcome { Reader = restored Value = .Ok(.Exit) }
        }
        _: {
            discard Payload
            ReadOutcome { Reader = restored Value = .Err(.Protocol) }
        }
    }
}

task WriteInput(
    $writer own Writer,
    event InputEvent
) Result<own Writer, Error> {
    const payload = EncodeInput(event) else error { return .Err(error) }
    const Writer { destination } = writer
    const sending = spawn desktopSend($destination, .JSON, $payload)
    const sent = $sending.wait()
    const restored = sent else error { return .Err(error) }
    .Ok(own Writer { destination = restored })
}

task Close($controller own Controller) Result<void, Error> {
    const Controller { control } = controller
    const closing = spawn mux.CloseStream($control)
    const result = $closing.wait()
    result else error {
        discard error
        return .Err(.Closed)
    }
    .Ok
}
